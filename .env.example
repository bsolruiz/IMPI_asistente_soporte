# Plantilla de variables de entorno para IMPI.
# Copia este archivo como  .env  y rellena tus valores reales.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# IA apagada por defecto para no consumir tokens. Ponla en true cuando la necesites.
AI_ENABLED=false

# Clave de la API de IA (o de la pasarela de la empresa). Dejar en blanco aqui.
ANTHROPIC_API_KEY=

# Clave secreta para firmar los tokens de sesion (JWT). Usa un valor largo y aleatorio.
JWT_SECRET_KEY=cambia-esto-por-un-valor-seguro

FLASK_ENV=development
